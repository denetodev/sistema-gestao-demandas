# Nomes das variáveis do backend. Valores reais ficam no Railway / no seu shell, nunca no git.
# Use o POOLER do Supabase (Project Settings > Database > Connection string > Session pooler):
DATABASE_URL=jdbc:postgresql://aws-0-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.<ref-do-projeto>
DATABASE_PASSWORD=
SUPABASE_URL=https://<ref-do-projeto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Origens permitidas, separadas por vírgula, sem barra no final
CORS_ALLOWED_ORIGINS=http://localhost:4200
