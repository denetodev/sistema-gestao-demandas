# Variáveis de ambiente do backend (Spring Boot).
# Copie para .env (ignorado pelo git) e preencha com valores reais.
# Em produção (Railway), essas chaves são configuradas direto no painel — não em arquivo.

# Conexão com o banco (Supabase/PostgreSQL)
DATABASE_URL=jdbc:postgresql://<host>:5432/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# Supabase (se o backend precisar chamar a API além do banco direto)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Autenticação — placeholder, entra de fato no M3
JWT_SECRET=

# Porta da aplicação (Railway injeta PORT automaticamente)
PORT=8080
